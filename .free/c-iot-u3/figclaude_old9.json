{
 "after_section": 2,
 "caption": "Browsing starts with one multicast PTR query for _ipp._tcp.local, and the instance name it returns is the key that unlocks SRV, TXT and the address lookup. Notice that SRV gives only a host name (printer.local), so the A record for 192.168.1.20 is a separate step before the TCP connection to port 631.",
 "spec": {
  "type": "blocks",
  "direction": "down",
  "title": "From PTR query to a printing connection",
  "nodes": [
   {
    "id": "q1",
    "label": "PTR query",
    "note": "for _ipp._tcp.local",
    "style": "accent"
   },
   {
    "id": "ptr",
    "label": "Instance name",
    "note": "MyPrinter._ipp._tcp.local",
    "style": "normal"
   },
   {
    "id": "srv",
    "label": "SRV + TXT",
    "note": "port 631, printer.local",
    "style": "normal"
   },
   {
    "id": "a",
    "label": "A record",
    "note": "192.168.1.20",
    "style": "normal"
   },
   {
    "id": "tcp",
    "label": "TCP to port 631",
    "note": "IPP printing starts",
    "style": "live"
   }
  ],
  "edges": [
   {
    "from": "q1",
    "to": "ptr",
    "label": "multicast",
    "style": "solid"
   },
   {
    "from": "ptr",
    "to": "srv",
    "label": "now ask SRV",
    "style": "solid"
   },
   {
    "from": "srv",
    "to": "a",
    "label": "resolve host",
    "style": "solid"
   },
   {
    "from": "a",
    "to": "tcp",
    "label": "connect",
    "style": "solid"
   }
  ]
 }
}