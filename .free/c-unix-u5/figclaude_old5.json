    "note": "0 of 65536 bytes",
    "style": "muted"
   },
   {
    "id": "w1",
    "label": "write 70000",
    "note": "returns 65536; 4464 left",
    "style": "accent"
   },
   {
    "id": "r1",
    "label": "read 8192",
    "note": "57344 bytes remain",
    "style": "live"
   },
   {
    "id": "w2",
    "label": "write 4464",
    "note": "8192 free, all fits",
    "style": "normal"
   },
   {
    "id": "end",
    "label": "Pipe holds 61808",
    "note": "57344 + 4464",
    "style": "accent"
   }
  ],
  "edges": [
