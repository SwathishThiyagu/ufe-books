 "examples": [
  {
   "question": "A 300 mm wide strip is rolled from 10 mm to 7 mm on rolls of radius 250 mm. The mean flow stress is 350 MPa and the mill runs at 50 rev/min. Estimate the roll force and the total power.",
   "steps": [
    "Draft Δh = h₀ − h₁ = 10 − 7 = 3 mm = 0.003 m.",
    "Projected contact length L = √(0.250 × 0.003) = 0.027386 m = 27.386 mm.",
    "Contact area per roll = wL = 0.300 × 0.027386 = 0.008216 m².",
    "Roll force F = σ̄ w L = 350×10⁶ × 0.008216 = 2.876×10⁶ N = 2.876 MN.",
    "Torque per roll T = F L/2 = 2.876×10⁶ × 0.027386/2 = 39,375 N·m = 39.375 kN·m.",
    "Angular speed ω = 2π×50/60 = 5.236 rad/s.",
    "Total power P = 2Tω = 2 × 39,375 × 5.236 = 412,334 W = 412.3 kW."
   ],
   "answer": "Roll force ≈ 2.876 MN (about 2.88 MN); total power ≈ 412.3 kW (about 412 kW).",
   "check": "import math\nw=0.300\nh0=10.0\nh1=7.0\nR=0.250\nsigma=350e6\nN=50.0\ndh=(h0-h1)/1000.0\nL=math.sqrt(R*dh)\nF=sigma*w*L\nT=F*L/2.0\nomega=2*math.pi*N/60.0\nP=2*T*omega\nprint(round(L*1000,3))\nprint(round(F/1e6,3))\nprint(round(T/1000,3))\nprint(round(omega,3))\nprint(round(P/1000,1))",
   "values": [
