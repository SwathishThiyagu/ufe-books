 "examples": [
  {
   "question": "A two‑class classification problem uses a Softmax output layer. The true class vector is t=[0,1]. The network produces raw scores z=[0.4, 1.2]. Compute the Softmax probabilities and the cross‑entropy loss.",
   "steps": [
    "Compute exp(z): exp(0.4)=1.4918, exp(1.2)=3.3201.",
    "Sum of exponentials Σ=1.4918+3.3201=4.8119.",
    "Softmax for class 1: p₁=1.4918 ÷ 4.8119 = 0.310.",
    "Softmax for class 2: p₂=3.3201 ÷ 4.8119 = 0.690.",
    "Cross‑entropy loss L = -log(p₂) = -log(0.690) = 0.371."
   ],
   "answer": "The loss is 0.371 (rounded to three decimal places).",
   "check": "import math\nz = [0.4, 1.2]\nexp_vals = [math.exp(v) for v in z]\nsum_exp = sum(exp_vals)\np = [v / sum_exp for v in exp_vals]\nloss = -math.log(p[1])\nprint(f\"{loss:.3f}\")",
   "values": [
    0.371
   ],
   "code": {
    "lang": "c",
    "code": "#include <stdio.h>\n#include <math.h>\nint main() {\n    double z[2] = {0.4, 1.2};\n    double exp0 = exp(z[0]);\n    double exp1 = exp(z[1]);\n    double sum = exp0 + exp1;\n    double p1 = exp0 / sum;\n    double p2 = exp1 / sum;\n    double loss = -log(p2);\n    printf(\"%0.10f\\n\", loss);\n    return 0;\n}",
    "stdin": ""
   },
