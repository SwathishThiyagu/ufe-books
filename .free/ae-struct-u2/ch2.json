 "examples": [
  {
   "question": "A steel cantilever is 2 m long, E = 200 GPa, I = 8 × 10⁻⁶ m⁴, tip load P = 1 kN. Find U(P) and tip deflection.",
   "steps": [
    "M = Px, so U = P²L³/(6EI).",
    "6EI = 9.6 × 10⁶ N·m², so U = 8.333 × 10⁻⁷ P² J = 0.833 J at 1 kN.",
    "∂U/∂P = 1.667 × 10⁻⁶ P = 1.667 mm."
   ],
   "answer": "U = 8.333 × 10⁻⁷ P² J, 0.833 J at 1 kN; tip deflection 1.667 mm downward.",
   "check": "E = 200e9\nI = 8e-6\nL = 2.0\nP = 1000.0\nc = L**3/(6*E*I)\nU = c*P**2\nd_mm = 2*c*P*1000\nprint(round(U,4))\nprint(round(d_mm,4))\n",
   "values": [
    0.8333,
    1.6667
   ],
   "output": "U = 0.8333 J\nΔ = 1.6667 mm"
  },
  {
   "question": "A stepped steel bar has E = 200 GPa and pull P = 50 kN. Segment 1: 0.4 m, 400 mm²; segment 2: 0.6 m, 200 mm². Find the extension.",
   "steps": [
    "U = P²L₁/(2A₁E) + P²L₂/(2A₂E).",
    "L₁/(A₁E) = 5.0 × 10⁻⁹ m/N; L₂/(A₂E) = 1.5 × 10⁻⁸ m/N; sum = 2.0 × 10⁻⁸ m/N.",
    "U = 1.0 × 10⁻⁸ P² J = 25 J at 50 kN.",
    "Δ = 2.0 × 10⁻⁸ P = 1.0 mm."
   ],
   "answer": "Extension 1.0 mm; stored energy 25 J.",
   "check": "E = 200e9\nP = 50000.0\nt1 = 0.4/(400e-6*E)\nt2 = 0.6/(200e-6*E)\nU = 0.5*P**2*(t1+t2)\nd_mm = P*(t1+t2)*1000\nprint(round(U,4))\nprint(round(d_mm,4))\n",
   "values": [
    25.0,
    1.0
   ],
   "output": "U = 25.0 J\nΔ = 1.0 mm"
  }
 ],
 "traps": [
  "Setting Q = 0 before differentiating makes ∂U/∂Q = 0.",
  "Differentiating with respect to a reaction. It returns the support's own movement, zero on a rigid support; ∂U/∂R = 0 finds a redundant reaction.",
  "Unit slips: J/N is m; J/kN is mm.",
  "dU/dP of P²L/(2AE) is PL/(AE), never PL/(2AE).",
  "Using U = ½PΔ with a deflection from a different load case."
 ],
 "quiz": [
  {
   "level": "remember",
   "q": "State Castigliano's second theorem for P and for M.",
   "marks": 2,
   "a": "∂U/∂P = Δ; ∂U/∂M = θ."
  },
  {
   "level": "understand",
   "q": "Why is ∂U/∂P a length?",
   "marks": 3,
   "a": "U = ½PΔ grows as P², so dU/dP = PL/(AE) = Δ, a length."
  },
  {
   "level": "apply",
   "q": "Bar: L = 3 m, A = 300 mm², E = 200 GPa, P = 30 kN. Find U and Δ.",
   "marks": 4,
   "a": "AE = 6 × 10⁷ N; U = 22.5 J; Δ = 2U/P = 1.5 mm."
  },
  {
   "level": "understand",
   "q": "What do you apply where no external load acts?",
   "marks": 2,
   "a": "A fictitious load Q, or a fictitious moment for rotation; set Q = 0 after differentiating."
  },
  {
   "level": "apply",
   "q": "When does the dummy load become zero? What if earlier?",
   "marks": 4,
   "a": "After differentiation. Earlier, U is constant in Q and ∂U/∂Q = 0."
  },
  {
   "level": "analyze",
   "q": "Two structures carry the same load P plus other loads and store the same total U. Must their deflection at P be equal?",
   "marks": 5,
   "a": "No. U = ½ΣPᵢΔᵢ is a mixture; the same total U does not fix ½PΔ_P."
  },
  {
   "level": "analyze",
   "q": "Why does the theorem fail for a nonlinear rubber cord?",
   "marks": 5,
   "a": "The proof uses U = ½PΔ, true only when Δ ∝ P; then ∂U/∂P is not the deflection."
  }
 ],
 "beyond": "Not for the exam. For many loads, ∂U/∂Pᵢ = Δᵢ gives the flexibility matrix, used in stiffness and finite element work. Aircraft flexibility methods use it for redundant frames and wing influence coefficients. Compare the dummy-load route with the unit load method in <a href=\"#virtual-work-and-unit-load-method\">2.3</a>."
}