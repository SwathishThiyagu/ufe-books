{
 "1": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 350\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Staircase of computer generations from vacuum tubes to multicore systems-on-chip\">\n          <defs><marker id=\"m111\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker></defs>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"16\" y=\"150\" width=\"128\" height=\"140\" rx=\"8\"/>\n            <rect x=\"156\" y=\"125\" width=\"128\" height=\"165\" rx=\"8\"/>\n            <rect x=\"296\" y=\"100\" width=\"128\" height=\"190\" rx=\"8\"/>\n            <rect x=\"436\" y=\"75\" width=\"128\" height=\"215\" rx=\"8\"/>\n            <rect x=\"576\" y=\"50\" width=\"128\" height=\"240\" rx=\"8\"/>\n          </g>\n          <g style=\"stroke:var(--line2);stroke-width:1.5\">\n            <line x1=\"16\" y1=\"180\" x2=\"144\" y2=\"180\"/><line x1=\"156\" y1=\"155\" x2=\"284\" y2=\"155\"/><line x1=\"296\" y1=\"130\" x2=\"424\" y2=\"130\"/><line x1=\"436\" y1=\"105\" x2=\"564\" y2=\"105\"/><line x1=\"576\" y1=\"80\" x2=\"704\" y2=\"80\"/>\n          </g>\n          <g fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"80\" y=\"171\">Generation 1</text><text x=\"220\" y=\"146\">Generation 2</text><text x=\"360\" y=\"121\">Generation 3</text><text x=\"500\" y=\"96\">Generation 4</text><text x=\"640\" y=\"71\">Multicore era</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"80\" y=\"200\">Vacuum tubes</text><text x=\"80\" y=\"220\">1945–1955</text><text x=\"80\" y=\"240\">ENIAC, EDSAC</text><text x=\"80\" y=\"260\">machine code</text>\n            <text x=\"220\" y=\"175\">Transistors</text><text x=\"220\" y=\"195\">1955–1965</text><text x=\"220\" y=\"215\">IBM 7090</text><text x=\"220\" y=\"235\">FORTRAN, COBOL</text>\n            <text x=\"360\" y=\"150\">ICs (SSI, MSI)</text><text x=\"360\" y=\"170\">1965–1971</text><text x=\"360\" y=\"190\">IBM 360, PDP-8</text><text x=\"360\" y=\"210\">minicomputers</text>\n            <text x=\"500\" y=\"125\">Microprocessors</text><text x=\"500\" y=\"145\">1971–2005</text><text x=\"500\" y=\"165\">8086, IBM PC</text><text x=\"500\" y=\"185\">PCs, networks</text>\n            <text x=\"640\" y=\"100\">Multicore SoCs</text><text x=\"640\" y=\"120\">2005 onward</text><text x=\"640\" y=\"140\">phones, cloud</text><text x=\"640\" y=\"160\">AI accelerators</text>\n          </g>\n          <line x1=\"16\" y1=\"310\" x2=\"700\" y2=\"310\" style=\"stroke:var(--accent);stroke-width:2.5\" marker-end=\"url(#m111)\"/>\n          <text x=\"360\" y=\"336\" fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">each step: smaller, faster, cheaper switches and less energy per operation</text>\n        </svg>\n        <figcaption><b>Figure 1.1.1</b> The generations as a staircase. Each column names the switching device, rough years, example machines and what software looked like. Notice that the last step is not a new device but a new way of using it: more cores instead of a faster clock.</figcaption>\n      </figure>",
 "2": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 430\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Block diagram of the five functional units: input, memory, ALU, control unit and output, with registers inside the processor\">\n          <defs>\n            <marker id=\"m121\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker>\n            <marker id=\"m122\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--live)\"/></marker>\n          </defs>\n          <rect x=\"200\" y=\"130\" width=\"320\" height=\"240\" rx=\"12\" style=\"fill:none;stroke:var(--line2);stroke-width:2;stroke-dasharray:7 5\"/>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"240\" y=\"30\" width=\"240\" height=\"70\" rx=\"8\"/>\n            <rect x=\"20\" y=\"170\" width=\"130\" height=\"70\" rx=\"8\"/>\n            <rect x=\"570\" y=\"170\" width=\"130\" height=\"70\" rx=\"8\"/>\n            <rect x=\"220\" y=\"170\" width=\"120\" height=\"60\" rx=\"8\"/>\n            <rect x=\"380\" y=\"170\" width=\"120\" height=\"60\" rx=\"8\"/>\n            <rect x=\"220\" y=\"280\" width=\"280\" height=\"70\" rx=\"8\"/>\n          </g>\n          <g fill=\"currentColor\" font-weight=\"700\" text-anchor=\"middle\" font-size=\"15\">\n            <text x=\"360\" y=\"60\">Memory unit</text><text x=\"85\" y=\"200\">Input unit</text><text x=\"635\" y=\"200\">Output unit</text>\n            <text x=\"280\" y=\"206\">ALU</text><text x=\"440\" y=\"206\">Registers</text><text x=\"360\" y=\"309\">Control unit</text>\n            <text x=\"210\" y=\"150\" font-size=\"13\" text-anchor=\"start\">Processor (CPU)</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"360\" y=\"84\">programs and data</text><text x=\"85\" y=\"222\">keyboard, sensor</text><text x=\"635\" y=\"222\">display, printer</text>\n            <text x=\"360\" y=\"332\">timing and control signals</text>\n            <text x=\"317\" y=\"121\" text-anchor=\"end\">read</text><text x=\"418\" y=\"121\" text-anchor=\"start\">write</text>\n          </g>\n          <g style=\"fill:none;stroke:var(--accent);stroke-width:2.2\" marker-end=\"url(#m121)\">\n            <path d=\"M85,170 V65 H238\"/><path d=\"M480,65 H635 V168\"/><path d=\"M325,100 V168\"/><path d=\"M410,170 V102\"/>\n            <path d=\"M150,205 H218\"/><path d=\"M500,205 H568\"/><path d=\"M343,200 H377\" marker-start=\"url(#m121)\"/>\n          </g>\n          <g style=\"fill:none;stroke:var(--live);stroke-width:2;stroke-dasharray:6 4\">\n            <path d=\"M360,350 V398\"/><path d=\"M85,398 H710\"/>\n            <path d=\"M85,398 V244\" marker-end=\"url(#m122)\"/><path d=\"M635,398 V244\" marker-end=\"url(#m122)\"/><path d=\"M710,398 V45 H484\" marker-end=\"url(#m122)\"/>\n            <path d=\"M280,280 V234\" marker-end=\"url(#m122)\"/><path d=\"M440,280 V234\" marker-end=\"url(#m122)\"/>\n          </g>\n          <text x=\"360\" y=\"418\" fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">control signals to every unit</text>\n        </svg>\n        <figcaption><b>Figure 1.2.1</b> The five functional units. Solid arrows carry instructions and data; dashed arrows carry control signals from the control unit. Notice that memory sits outside the processor, and that the control unit talks to every other unit, including the ALU and registers next to it.</figcaption>\n      </figure>",
 "3": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 340\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Von Neumann machine with one memory and one bus beside a Harvard machine with separate instruction and data memories and two buses\">\n          <defs>\n            <marker id=\"m131\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker>\n            <marker id=\"m132\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--next)\"/></marker>\n          </defs>\n          <line x1=\"360\" y1=\"15\" x2=\"360\" y2=\"325\" style=\"stroke:var(--line2);stroke-width:1.5;stroke-dasharray:6 5\"/>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"90\" y=\"50\" width=\"180\" height=\"80\" rx=\"8\"/><rect x=\"50\" y=\"210\" width=\"260\" height=\"80\" rx=\"8\"/>\n            <rect x=\"450\" y=\"50\" width=\"180\" height=\"80\" rx=\"8\"/><rect x=\"375\" y=\"210\" width=\"150\" height=\"80\" rx=\"8\"/>\n          </g>\n          <rect x=\"550\" y=\"210\" width=\"150\" height=\"80\" rx=\"8\" style=\"fill:var(--panel);stroke:var(--next);stroke-width:2\"/>\n          <g fill=\"currentColor\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"180\" y=\"32\" font-size=\"16\">Von Neumann</text><text x=\"540\" y=\"32\" font-size=\"16\">Harvard</text>\n            <text x=\"180\" y=\"83\" font-size=\"15\">CPU</text><text x=\"540\" y=\"83\" font-size=\"15\">CPU</text>\n            <text x=\"180\" y=\"242\" font-size=\"15\">Memory</text>\n            <text x=\"450\" y=\"238\" font-size=\"14\">Instruction</text><text x=\"450\" y=\"256\" font-size=\"14\">memory</text>\n            <text x=\"625\" y=\"245\" font-size=\"14\">Data memory</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"180\" y=\"108\">ALU + control unit</text><text x=\"540\" y=\"108\">ALU + control unit</text>\n            <text x=\"180\" y=\"267\">instructions + data</text><text x=\"450\" y=\"279\">program code</text><text x=\"625\" y=\"268\">variables</text>\n            <text x=\"192\" y=\"175\" text-anchor=\"start\">one shared bus</text>\n            <text x=\"478\" y=\"160\" text-anchor=\"start\">instruction bus</text><text x=\"602\" y=\"190\" text-anchor=\"end\">data bus</text>\n            <text x=\"180\" y=\"316\">fetches and data accesses take turns</text>\n            <text x=\"540\" y=\"316\">both buses can work in the same cycle</text>\n          </g>\n          <path d=\"M180,132 V208\" style=\"fill:none;stroke:var(--accent);stroke-width:4\" marker-start=\"url(#m131)\" marker-end=\"url(#m131)\"/>\n          <path d=\"M470,132 V208\" style=\"fill:none;stroke:var(--accent);stroke-width:4\" marker-start=\"url(#m131)\" marker-end=\"url(#m131)\"/>\n          <path d=\"M610,132 V208\" style=\"fill:none;stroke:var(--next);stroke-width:4\" marker-start=\"url(#m132)\" marker-end=\"url(#m132)\"/>\n        </svg>\n        <figcaption><b>Figure 1.3.1</b> Left: a von Neumann machine, one memory and one bus, so an instruction fetch and a data access cannot happen together. Right: a Harvard machine, two memories and two buses, so both can happen in the same cycle. Notice that the Harvard CPU still stores its program; it just keeps it in a memory of its own.</figcaption>\n      </figure>",
 "4": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 410\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Processor registers PC, IR, MAR, MDR connected to memory, and the six-step instruction cycle as a loop\">\n          <defs><marker id=\"m141\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker>\n            <marker id=\"m142\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--live)\"/></marker></defs>\n          <rect x=\"16\" y=\"16\" width=\"470\" height=\"180\" rx=\"12\" style=\"fill:none;stroke:var(--line2);stroke-width:2;stroke-dasharray:7 5\"/>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"36\" y=\"50\" width=\"90\" height=\"40\" rx=\"6\"/><rect x=\"140\" y=\"50\" width=\"90\" height=\"40\" rx=\"6\"/><rect x=\"244\" y=\"50\" width=\"120\" height=\"40\" rx=\"6\"/><rect x=\"380\" y=\"50\" width=\"90\" height=\"40\" rx=\"6\"/>\n            <rect x=\"36\" y=\"125\" width=\"150\" height=\"40\" rx=\"6\"/><rect x=\"200\" y=\"125\" width=\"90\" height=\"40\" rx=\"6\"/><rect x=\"380\" y=\"125\" width=\"90\" height=\"40\" rx=\"6\"/>\n            <rect x=\"560\" y=\"40\" width=\"144\" height=\"120\" rx=\"8\"/>\n          </g>\n          <g fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"30\" y=\"38\" font-size=\"14\" text-anchor=\"start\">Processor</text>\n            <text x=\"81\" y=\"76\">PC</text><text x=\"185\" y=\"76\">IR</text><text x=\"304\" y=\"76\" font-size=\"14\">Control unit</text><text x=\"425\" y=\"76\">MAR</text>\n            <text x=\"111\" y=\"151\">R0 … R(n−1)</text><text x=\"245\" y=\"151\">ALU</text><text x=\"425\" y=\"151\">MDR</text>\n            <text x=\"632\" y=\"92\">Memory</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"632\" y=\"116\">byte addressed</text>\n            <text x=\"514\" y=\"62\">address</text><text x=\"514\" y=\"137\">data</text><text x=\"590\" y=\"200\">Read, Write</text>\n          </g>\n          <path d=\"M470,70 H558\" style=\"fill:none;stroke:var(--accent);stroke-width:2.2\" marker-end=\"url(#m141)\"/>\n          <path d=\"M472,145 H558\" style=\"fill:none;stroke:var(--accent);stroke-width:2.2\" marker-start=\"url(#m141)\" marker-end=\"url(#m141)\"/>\n          <path d=\"M304,90 V180 H632 V162\" style=\"fill:none;stroke:var(--live);stroke-width:2;stroke-dasharray:6 4\" marker-end=\"url(#m142)\"/>\n          <text x=\"16\" y=\"240\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\">Instruction cycle</text>\n          <g style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"16\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/><rect x=\"134\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/><rect x=\"252\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/>\n            <rect x=\"370\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/><rect x=\"488\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/><rect x=\"606\" y=\"255\" width=\"100\" height=\"56\" rx=\"8\"/>\n          </g>\n          <g fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"66\" y=\"279\">1 Fetch</text><text x=\"184\" y=\"279\">2 Decode</text><text x=\"302\" y=\"279\">3 Operand</text><text x=\"420\" y=\"279\">4 Execute</text><text x=\"538\" y=\"279\">5 Store</text><text x=\"656\" y=\"279\">6 Interrupt</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"66\" y=\"299\">IR ← M[PC]</text><text x=\"184\" y=\"299\">read opcode</text><text x=\"302\" y=\"299\">fetch</text><text x=\"420\" y=\"299\">ALU works</text><text x=\"538\" y=\"299\">result</text><text x=\"656\" y=\"299\">check</text>\n            <text x=\"361\" y=\"365\">repeat: the PC already points to the next instruction</text>\n            <text x=\"361\" y=\"394\">step 1 = fetch phase · steps 2–5 = execute phase · step 6 = interrupt check</text>\n          </g>\n          <g style=\"fill:none;stroke:var(--accent);stroke-width:2\" marker-end=\"url(#m141)\">\n            <path d=\"M116,283 H132\"/><path d=\"M234,283 H250\"/><path d=\"M352,283 H368\"/><path d=\"M470,283 H486\"/><path d=\"M588,283 H604\"/>\n            <path d=\"M656,311 V342 H66 V313\"/>\n          </g>\n        </svg>\n        <figcaption><b>Figure 1.4.1</b> Top: the processor reaches memory only through MAR (address out) and MDR (data in or out), with Read and Write from the control unit. Bottom: the instruction cycle. Notice that the PC is updated during the fetch, so when the loop returns to step 1 the next address is already waiting.</figcaption>\n      </figure>",
 "5": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 316\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"System bus: processor, memory and two I/O interfaces tapped onto address, data and control buses\">\n          <defs>\n            <marker id=\"m151\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker>\n            <marker id=\"m152\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--next)\"/></marker>\n            <marker id=\"m153\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--live)\"/></marker>\n          </defs>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"130\" y=\"30\" width=\"128\" height=\"70\" rx=\"8\"/><rect x=\"278\" y=\"30\" width=\"128\" height=\"70\" rx=\"8\"/><rect x=\"426\" y=\"30\" width=\"128\" height=\"70\" rx=\"8\"/><rect x=\"574\" y=\"30\" width=\"128\" height=\"70\" rx=\"8\"/>\n          </g>\n          <g fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"194\" y=\"60\">Processor</text><text x=\"342\" y=\"60\">Memory</text><text x=\"490\" y=\"60\">I/O interface</text><text x=\"638\" y=\"60\">I/O interface</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"194\" y=\"82\">MAR, MDR</text><text x=\"342\" y=\"82\">main memory</text><text x=\"490\" y=\"82\">keyboard</text><text x=\"638\" y=\"82\">SSD</text>\n            <text x=\"360\" y=\"280\">8086: 20 address lines (2²⁰ = 1 MB) and 16 data lines</text>\n            <text x=\"360\" y=\"302\">control lines include RD, WR, M/IO, ALE, READY and INTR</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" font-weight=\"700\">\n            <text x=\"16\" y=\"155\">Address bus</text><text x=\"16\" y=\"200\">Data bus</text><text x=\"16\" y=\"245\">Control bus</text>\n          </g>\n          <line x1=\"130\" y1=\"150\" x2=\"704\" y2=\"150\" style=\"stroke:var(--accent);stroke-width:5\"/>\n          <line x1=\"130\" y1=\"195\" x2=\"704\" y2=\"195\" style=\"stroke:var(--next);stroke-width:5\"/>\n          <line x1=\"130\" y1=\"240\" x2=\"704\" y2=\"240\" style=\"stroke:var(--live);stroke-width:5\"/>\n          <g style=\"fill:none;stroke:var(--accent);stroke-width:2\">\n            <path d=\"M164,100 V145\" marker-end=\"url(#m151)\"/><path d=\"M312,148 V103\" marker-end=\"url(#m151)\"/><path d=\"M460,148 V103\" marker-end=\"url(#m151)\"/><path d=\"M608,148 V103\" marker-end=\"url(#m151)\"/>\n          </g>\n          <g style=\"fill:none;stroke:var(--next);stroke-width:2\" marker-start=\"url(#m152)\" marker-end=\"url(#m152)\">\n            <path d=\"M194,103 V190\"/><path d=\"M342,103 V190\"/><path d=\"M490,103 V190\"/><path d=\"M638,103 V190\"/>\n          </g>\n          <g style=\"fill:none;stroke:var(--live);stroke-width:2\" marker-start=\"url(#m153)\" marker-end=\"url(#m153)\">\n            <path d=\"M224,103 V235\"/><path d=\"M372,103 V235\"/><path d=\"M520,103 V235\"/><path d=\"M668,103 V235\"/>\n          </g>\n        </svg>\n        <figcaption><b>Figure 1.5.1</b> The system bus. The address taps point one way, from the processor to the bus and from the bus into memory and the I/O interfaces; data and control taps point both ways. Notice that every unit hangs on the same three lines, so only one transfer can use them at a time.</figcaption>\n      </figure>",
 "6": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 330\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"CPU time as instruction count times CPI times clock period, with the design choices that set each factor\">\n          <defs><marker id=\"m161\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--accent)\"/></marker></defs>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"16\" y=\"40\" width=\"150\" height=\"76\" rx=\"8\"/><rect x=\"200\" y=\"40\" width=\"150\" height=\"76\" rx=\"8\"/><rect x=\"384\" y=\"40\" width=\"150\" height=\"76\" rx=\"8\"/>\n          </g>\n          <rect x=\"568\" y=\"40\" width=\"136\" height=\"76\" rx=\"8\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <g style=\"fill:none;stroke:var(--line2);stroke-width:1.5;stroke-dasharray:5 4\">\n            <rect x=\"16\" y=\"165\" width=\"150\" height=\"115\" rx=\"8\"/><rect x=\"200\" y=\"165\" width=\"150\" height=\"115\" rx=\"8\"/><rect x=\"384\" y=\"165\" width=\"150\" height=\"115\" rx=\"8\"/>\n          </g>\n          <g fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">\n            <text x=\"91\" y=\"64\">Instructions</text><text x=\"275\" y=\"64\">Cycles per</text><text x=\"459\" y=\"64\">Seconds</text><text x=\"636\" y=\"64\">CPU time</text>\n            <text x=\"183\" y=\"86\" font-size=\"22\">×</text><text x=\"367\" y=\"86\" font-size=\"22\">×</text><text x=\"551\" y=\"86\" font-size=\"22\">=</text>\n          </g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"91\" y=\"85\">per program</text><text x=\"275\" y=\"85\">instruction</text><text x=\"459\" y=\"85\">per cycle</text><text x=\"636\" y=\"85\">seconds per</text>\n            <text x=\"91\" y=\"106\" font-weight=\"700\">IC</text><text x=\"275\" y=\"106\" font-weight=\"700\">CPI</text><text x=\"459\" y=\"106\" font-weight=\"700\">T = 1 ÷ f</text><text x=\"636\" y=\"106\">program</text>\n            <text x=\"91\" y=\"186\" font-style=\"italic\">set by</text><text x=\"275\" y=\"186\" font-style=\"italic\">set by</text><text x=\"459\" y=\"186\" font-style=\"italic\">set by</text>\n            <text x=\"91\" y=\"207\">algorithm</text><text x=\"91\" y=\"227\">language</text><text x=\"91\" y=\"247\">compiler</text><text x=\"91\" y=\"267\">ISA</text>\n            <text x=\"275\" y=\"207\">compiler</text><text x=\"275\" y=\"227\">ISA</text><text x=\"275\" y=\"247\">pipeline</text><text x=\"275\" y=\"267\">cache, memory</text>\n            <text x=\"459\" y=\"207\">organization</text><text x=\"459\" y=\"227\">technology</text><text x=\"459\" y=\"247\">power limit</text>\n            <text x=\"636\" y=\"200\">the only fully</text><text x=\"636\" y=\"220\">reliable measure</text>\n            <text x=\"190\" y=\"312\">MIPS = IC ÷ (time × 10⁶) = f ÷ (CPI × 10⁶)</text><text x=\"545\" y=\"312\">MFLOPS = FP operations ÷ (time × 10⁶)</text>\n          </g>\n          <g style=\"fill:none;stroke:var(--accent);stroke-width:2\" marker-end=\"url(#m161)\">\n            <path d=\"M91,163 V120\"/><path d=\"M275,163 V120\"/><path d=\"M459,163 V120\"/>\n          </g>\n        </svg>\n        <figcaption><b>Figure 1.6.1</b> CPU time is the product of three factors, and each design choice moves one or two of them. Notice that the compiler and the ISA appear under both IC and CPI: a change that cuts the instruction count can raise the CPI, so only the product tells you who wins.</figcaption>\n      </figure>",
 "7": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 330\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Bar charts of dynamic power and throughput for three processor designs computed in the worked example\">\n          <g fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\"><text x=\"205\" y=\"28\">Dynamic power (W)</text><text x=\"565\" y=\"28\">Throughput (relative to A)</text></g>\n          <g style=\"stroke:var(--line2);stroke-width:1;stroke-dasharray:4 4\">\n            <line x1=\"70\" y1=\"210\" x2=\"340\" y2=\"210\"/><line x1=\"70\" y1=\"160\" x2=\"340\" y2=\"160\"/><line x1=\"70\" y1=\"110\" x2=\"340\" y2=\"110\"/><line x1=\"70\" y1=\"60\" x2=\"340\" y2=\"60\"/>\n            <line x1=\"430\" y1=\"210\" x2=\"700\" y2=\"210\"/><line x1=\"430\" y1=\"160\" x2=\"700\" y2=\"160\"/><line x1=\"430\" y1=\"110\" x2=\"700\" y2=\"110\"/><line x1=\"430\" y1=\"60\" x2=\"700\" y2=\"60\"/>\n          </g>\n          <path d=\"M70,50 V260 H340 M430,50 V260 H700\" style=\"fill:none;stroke:var(--ink);stroke-width:1.5\"/>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"end\">\n            <text x=\"62\" y=\"264\">0</text><text x=\"62\" y=\"214\">25</text><text x=\"62\" y=\"164\">50</text><text x=\"62\" y=\"114\">75</text><text x=\"62\" y=\"64\">100</text>\n            <text x=\"422\" y=\"264\">0</text><text x=\"422\" y=\"214\">0.5</text><text x=\"422\" y=\"164\">1.0</text><text x=\"422\" y=\"114\">1.5</text><text x=\"422\" y=\"64\">2.0</text>\n          </g>\n          <g style=\"fill:var(--accent)\"><rect x=\"95\" y=\"87.2\" width=\"56\" height=\"172.8\"/><rect x=\"175\" y=\"164\" width=\"56\" height=\"96\"/><rect x=\"255\" y=\"68\" width=\"56\" height=\"192\"/></g>\n          <g style=\"fill:var(--next)\"><rect x=\"455\" y=\"160\" width=\"56\" height=\"100\"/><rect x=\"535\" y=\"180\" width=\"56\" height=\"80\"/><rect x=\"615\" y=\"100\" width=\"56\" height=\"160\"/></g>\n          <g fill=\"currentColor\" font-size=\"13\" text-anchor=\"middle\">\n            <text x=\"123\" y=\"79\">86.4 W</text><text x=\"203\" y=\"156\">48 W</text><text x=\"283\" y=\"90\" style=\"fill:var(--accent-ink)\">96 W</text>\n            <text x=\"483\" y=\"152\">1.0</text><text x=\"563\" y=\"172\">0.8</text><text x=\"643\" y=\"92\">1.6</text>\n            <text x=\"123\" y=\"280\" font-weight=\"700\">A</text><text x=\"203\" y=\"280\" font-weight=\"700\">B</text><text x=\"283\" y=\"280\" font-weight=\"700\">C</text>\n            <text x=\"483\" y=\"280\" font-weight=\"700\">A</text><text x=\"563\" y=\"280\" font-weight=\"700\">B</text><text x=\"643\" y=\"280\" font-weight=\"700\">C</text>\n            <text x=\"360\" y=\"312\">A: 1 core, 3.0 GHz, 1.2 V · B: 1 core, 2.4 GHz, 1.0 V · C: 2 cores, 2.4 GHz, 1.0 V</text>\n          </g>\n        </svg>\n        <figcaption><b>Figure 1.7.1</b> Power and throughput of the three designs in the worked example. Notice that two slower cores (C) give 1.6 times A's throughput for only 11% more power, if the program can use both cores.</figcaption>\n      </figure>"
}