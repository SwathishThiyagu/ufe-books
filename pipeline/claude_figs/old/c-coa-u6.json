{
 "1": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 410\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Memory hierarchy pyramid from registers at the top to hard disk at the bottom, with typical access times\">\n          <defs><marker id=\"m611\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <text x=\"590\" y=\"20\" font-size=\"13\" fill=\"currentColor\" font-weight=\"600\">Typical access</text>\n          <rect x=\"255\" y=\"30\" width=\"150\" height=\"40\" rx=\"6\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"330\" y=\"55\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Registers</text>\n          <rect x=\"230\" y=\"78\" width=\"200\" height=\"40\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"330\" y=\"103\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">L1 cache · 32–64 KB</text>\n          <rect x=\"205\" y=\"126\" width=\"250\" height=\"40\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"330\" y=\"151\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">L2 cache · 0.25–2 MB</text>\n          <rect x=\"180\" y=\"174\" width=\"300\" height=\"40\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"330\" y=\"199\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">L3 cache · 8–64 MB</text>\n          <rect x=\"155\" y=\"222\" width=\"350\" height=\"40\" rx=\"6\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <text x=\"330\" y=\"247\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Main memory (DRAM) · 8–64 GB</text>\n          <rect x=\"130\" y=\"270\" width=\"400\" height=\"40\" rx=\"6\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <text x=\"330\" y=\"295\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">SSD (NAND flash) · 0.5–4 TB</text>\n          <rect x=\"105\" y=\"318\" width=\"450\" height=\"40\" rx=\"6\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <text x=\"330\" y=\"343\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Hard disk (magnetic) · 1–20 TB</text>\n          <text x=\"590\" y=\"55\" font-size=\"13\" fill=\"currentColor\">≈ 0.3 ns</text>\n          <text x=\"590\" y=\"103\" font-size=\"13\" fill=\"currentColor\">≈ 1 ns</text>\n          <text x=\"590\" y=\"151\" font-size=\"13\" fill=\"currentColor\">≈ 4 ns</text>\n          <text x=\"590\" y=\"199\" font-size=\"13\" fill=\"currentColor\">≈ 15 ns</text>\n          <text x=\"590\" y=\"247\" font-size=\"13\" fill=\"currentColor\">≈ 60–100 ns</text>\n          <text x=\"590\" y=\"295\" font-size=\"13\" fill=\"currentColor\">≈ 50–100 µs</text>\n          <text x=\"590\" y=\"343\" font-size=\"13\" fill=\"currentColor\">≈ 5–10 ms</text>\n          <line x1=\"62\" y1=\"350\" x2=\"62\" y2=\"40\" style=\"stroke:var(--muted);stroke-width:2\" marker-start=\"url(#m611)\" marker-end=\"url(#m611)\"/>\n          <text x=\"44\" y=\"195\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" transform=\"rotate(-90 44 195)\">up: faster, costlier per byte</text>\n          <text x=\"84\" y=\"195\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" transform=\"rotate(-90 84 195)\">down: larger, cheaper per byte</text>\n          <text x=\"360\" y=\"392\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">Managed by: compiler (registers) · hardware (caches) · OS (memory ↔ disk)</text>\n        </svg>\n        <figcaption><b>Figure 6.1.1</b> The memory hierarchy of a typical desktop computer. Each step down is larger and slower; the steps grow towards the bottom, and going from DRAM to an SSD costs about a thousand times in access time. Notice who manages each boundary. Values are typical orders of magnitude, not the figures of one chip.</figcaption>\n      </figure>",
 "2": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 415\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"A 4M by 32 memory built from sixteen 1M by 8 chips in four rows, with a 2-to-4 decoder driving the chip selects\">\n          <defs><marker id=\"m621\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <text x=\"460\" y=\"40\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">A0–A19 and R/W go to all 16 chips</text>\n          <text x=\"110\" y=\"22\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">A21, A20</text>\n          <line x1=\"110\" y1=\"30\" x2=\"110\" y2=\"58\" style=\"stroke:var(--muted);stroke-width:2\" marker-end=\"url(#m621)\"/>\n          <line x1=\"280\" y1=\"60\" x2=\"280\" y2=\"350\" style=\"stroke:var(--next);stroke-width:2\"/>\n          <line x1=\"400\" y1=\"60\" x2=\"400\" y2=\"350\" style=\"stroke:var(--next);stroke-width:2\"/>\n          <line x1=\"520\" y1=\"60\" x2=\"520\" y2=\"350\" style=\"stroke:var(--next);stroke-width:2\"/>\n          <line x1=\"640\" y1=\"60\" x2=\"640\" y2=\"350\" style=\"stroke:var(--next);stroke-width:2\"/>\n          <line x1=\"230\" y1=\"350\" x2=\"690\" y2=\"350\" style=\"stroke:var(--next);stroke-width:4\"/>\n          <line x1=\"160\" y1=\"83\" x2=\"690\" y2=\"83\" style=\"stroke:var(--live);stroke-width:2\"/>\n          <line x1=\"160\" y1=\"153\" x2=\"690\" y2=\"153\" style=\"stroke:var(--live);stroke-width:2\"/>\n          <line x1=\"160\" y1=\"223\" x2=\"690\" y2=\"223\" style=\"stroke:var(--live);stroke-width:2\"/>\n          <line x1=\"160\" y1=\"293\" x2=\"690\" y2=\"293\" style=\"stroke:var(--live);stroke-width:2\"/>\n          <rect x=\"60\" y=\"60\" width=\"100\" height=\"256\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"110\" y=\"182\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">2-to-4</text>\n          <text x=\"110\" y=\"200\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">decoder</text>\n          <text x=\"168\" y=\"76\" font-size=\"13\" fill=\"currentColor\">CS0</text>\n          <text x=\"168\" y=\"146\" font-size=\"13\" fill=\"currentColor\">CS1</text>\n          <text x=\"168\" y=\"216\" font-size=\"13\" fill=\"currentColor\">CS2</text>\n          <text x=\"168\" y=\"286\" font-size=\"13\" fill=\"currentColor\">CS3</text>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\">\n            <rect x=\"230\" y=\"60\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"350\" y=\"60\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"470\" y=\"60\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"590\" y=\"60\" width=\"100\" height=\"46\" rx=\"5\"/>\n            <rect x=\"230\" y=\"130\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"350\" y=\"130\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"470\" y=\"130\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"590\" y=\"130\" width=\"100\" height=\"46\" rx=\"5\"/>\n            <rect x=\"230\" y=\"200\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"350\" y=\"200\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"470\" y=\"200\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"590\" y=\"200\" width=\"100\" height=\"46\" rx=\"5\"/>\n            <rect x=\"230\" y=\"270\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"350\" y=\"270\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"470\" y=\"270\" width=\"100\" height=\"46\" rx=\"5\"/><rect x=\"590\" y=\"270\" width=\"100\" height=\"46\" rx=\"5\"/>\n          </g>\n          <g font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">\n            <text x=\"280\" y=\"88\">1M × 8</text><text x=\"400\" y=\"88\">1M × 8</text><text x=\"520\" y=\"88\">1M × 8</text><text x=\"640\" y=\"88\">1M × 8</text>\n            <text x=\"280\" y=\"158\">1M × 8</text><text x=\"400\" y=\"158\">1M × 8</text><text x=\"520\" y=\"158\">1M × 8</text><text x=\"640\" y=\"158\">1M × 8</text>\n            <text x=\"280\" y=\"228\">1M × 8</text><text x=\"400\" y=\"228\">1M × 8</text><text x=\"520\" y=\"228\">1M × 8</text><text x=\"640\" y=\"228\">1M × 8</text>\n            <text x=\"280\" y=\"298\">1M × 8</text><text x=\"400\" y=\"298\">1M × 8</text><text x=\"520\" y=\"298\">1M × 8</text><text x=\"640\" y=\"298\">1M × 8</text>\n          </g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">\n            <text x=\"280\" y=\"372\">D31–D24</text><text x=\"400\" y=\"372\">D23–D16</text><text x=\"520\" y=\"372\">D15–D8</text><text x=\"640\" y=\"372\">D7–D0</text>\n            <text x=\"460\" y=\"398\">32-bit data bus to the processor</text>\n          </g>\n        </svg>\n        <figcaption><b>Figure 6.2.1</b> A 4M × 32 memory from sixteen 1M × 8 chips. The orange chip-select line of a row reaches all four chips in it; the green data lines of a column share one byte of the data bus. Only the selected row drives the bus, so the four rows take turns on the same 32 wires.</figcaption>\n      </figure>",
 "3": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Direct-mapped cache lookup: the index selects a line, its tag is compared with the address tag, the result is ANDed with the valid bit to give Hit, and the offset selects the word\">\n          <defs><marker id=\"m631\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\"><text x=\"170\" y=\"30\">V</text><text x=\"290\" y=\"30\">Tag</text><text x=\"520\" y=\"30\">Data (32-byte block)</text></g>\n          <g style=\"fill:var(--panel);stroke:var(--line2);stroke-width:1.5\">\n            <rect x=\"150\" y=\"40\" width=\"40\" height=\"30\"/><rect x=\"190\" y=\"40\" width=\"200\" height=\"30\"/><rect x=\"390\" y=\"40\" width=\"260\" height=\"30\"/>\n            <rect x=\"150\" y=\"70\" width=\"40\" height=\"30\"/><rect x=\"190\" y=\"70\" width=\"200\" height=\"30\"/><rect x=\"390\" y=\"70\" width=\"260\" height=\"30\"/>\n            <rect x=\"150\" y=\"100\" width=\"40\" height=\"30\"/><rect x=\"190\" y=\"100\" width=\"200\" height=\"30\"/><rect x=\"390\" y=\"100\" width=\"260\" height=\"30\"/>\n          </g>\n          <g style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"><rect x=\"150\" y=\"130\" width=\"40\" height=\"30\"/><rect x=\"190\" y=\"130\" width=\"200\" height=\"30\"/><rect x=\"390\" y=\"130\" width=\"260\" height=\"30\"/></g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">\n            <text x=\"170\" y=\"60\">1</text><text x=\"290\" y=\"60\">tag of line 0</text><text x=\"520\" y=\"60\">line 0</text>\n            <text x=\"170\" y=\"90\">0</text><text x=\"290\" y=\"90\">—</text><text x=\"520\" y=\"90\">line 1 (empty)</text>\n            <text x=\"290\" y=\"120\">⋮</text><text x=\"520\" y=\"120\">⋮ (2,048 lines)</text>\n            <text x=\"170\" y=\"150\">1</text><text x=\"290\" y=\"150\">stored tag</text><text x=\"520\" y=\"150\">line i: words 0–7</text>\n          </g>\n          <rect x=\"250\" y=\"200\" width=\"80\" height=\"40\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"290\" y=\"225\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">= ?</text>\n          <rect x=\"150\" y=\"262\" width=\"60\" height=\"38\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"180\" y=\"286\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">AND</text>\n          <rect x=\"460\" y=\"200\" width=\"120\" height=\"40\" rx=\"6\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"520\" y=\"225\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">select word</text>\n          <g style=\"stroke:var(--muted);stroke-width:2;fill:none\" marker-end=\"url(#m631)\">\n            <path d=\"M290,160 V198\"/>\n            <path d=\"M290,330 V242\"/>\n            <path d=\"M165,160 V260\"/>\n            <path d=\"M250,220 H195 V260\"/>\n            <path d=\"M150,281 H82\"/>\n            <path d=\"M520,160 V198\"/>\n            <path d=\"M605,330 V220 H582\"/>\n            <path d=\"M520,240 V288\"/>\n            <path d=\"M475,370 V388 H30 V145 H148\"/>\n          </g>\n          <text x=\"58\" y=\"286\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Hit</text>\n          <text x=\"520\" y=\"306\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">word to processor</text>\n          <text x=\"140\" y=\"355\" font-size=\"13\" text-anchor=\"end\" fill=\"currentColor\">Address:</text>\n          <rect x=\"150\" y=\"330\" width=\"240\" height=\"40\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <rect x=\"390\" y=\"330\" width=\"170\" height=\"40\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <rect x=\"560\" y=\"330\" width=\"90\" height=\"40\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"240\" y=\"355\">Tag · 16 bits</text><text x=\"475\" y=\"355\">Index · 11 bits</text><text x=\"605\" y=\"355\">Offset · 5</text></g>\n          <text x=\"250\" y=\"408\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">the index picks line i (one of 2,048)</text>\n        </svg>\n        <figcaption><b>Figure 6.3.1</b> Lookup in a direct-mapped 64 KB cache with 32-byte blocks and 32-bit addresses. The index chooses one line; its stored tag is compared with the address tag, and Hit = (tags equal) AND V. In parallel the offset picks the word from the block, so data is ready the moment Hit is known.</figcaption>\n      </figure>",
 "4": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 380\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Stacked bar chart of CPI: perfect cache 1.2, L1 only 4.7, L1 plus L2 2.25\">\n          <rect x=\"120\" y=\"14\" width=\"16\" height=\"14\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"/>\n          <text x=\"142\" y=\"26\" font-size=\"13\" fill=\"currentColor\">Base CPI</text>\n          <rect x=\"250\" y=\"14\" width=\"16\" height=\"14\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:1.5\"/>\n          <text x=\"272\" y=\"26\" font-size=\"13\" fill=\"currentColor\">Instruction-miss stalls</text>\n          <rect x=\"455\" y=\"14\" width=\"16\" height=\"14\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:1.5\"/>\n          <text x=\"477\" y=\"26\" font-size=\"13\" fill=\"currentColor\">Data-miss stalls</text>\n          <line x1=\"110\" y1=\"320\" x2=\"620\" y2=\"320\" style=\"stroke:var(--line2);stroke-width:1.5\"/>\n          <line x1=\"110\" y1=\"40\" x2=\"110\" y2=\"320\" style=\"stroke:var(--line2);stroke-width:1.5\"/>\n          <g style=\"stroke:var(--line2);stroke-width:1\" stroke-dasharray=\"3 4\"><line x1=\"110\" y1=\"264\" x2=\"620\" y2=\"264\"/><line x1=\"110\" y1=\"208\" x2=\"620\" y2=\"208\"/><line x1=\"110\" y1=\"152\" x2=\"620\" y2=\"152\"/><line x1=\"110\" y1=\"96\" x2=\"620\" y2=\"96\"/><line x1=\"110\" y1=\"40\" x2=\"620\" y2=\"40\"/></g>\n          <g font-size=\"13\" text-anchor=\"end\" fill=\"currentColor\"><text x=\"102\" y=\"324\">0</text><text x=\"102\" y=\"268\">1</text><text x=\"102\" y=\"212\">2</text><text x=\"102\" y=\"156\">3</text><text x=\"102\" y=\"100\">4</text><text x=\"102\" y=\"44\">5</text></g>\n          <text x=\"48\" y=\"180\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" transform=\"rotate(-90 48 180)\">Cycles per instruction</text>\n          <rect x=\"150\" y=\"252.8\" width=\"110\" height=\"67.2\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"/>\n          <rect x=\"320\" y=\"252.8\" width=\"110\" height=\"67.2\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"/>\n          <rect x=\"320\" y=\"140.8\" width=\"110\" height=\"112\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:1.5\"/>\n          <rect x=\"320\" y=\"56.8\" width=\"110\" height=\"84\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:1.5\"/>\n          <rect x=\"490\" y=\"252.8\" width=\"110\" height=\"67.2\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"/>\n          <rect x=\"490\" y=\"219.2\" width=\"110\" height=\"33.6\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:1.5\"/>\n          <rect x=\"490\" y=\"194\" width=\"110\" height=\"25.2\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:1.5\"/>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">\n            <text x=\"205\" y=\"291\">1.2</text><text x=\"375\" y=\"291\">1.2</text><text x=\"375\" y=\"201\">2.0</text><text x=\"375\" y=\"104\">1.5</text>\n            <text x=\"545\" y=\"291\">1.2</text><text x=\"545\" y=\"241\">0.6</text><text x=\"545\" y=\"211\">0.45</text>\n          </g>\n          <g font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\"><text x=\"205\" y=\"244\">1.2</text><text x=\"375\" y=\"50\">4.7</text><text x=\"545\" y=\"186\">2.25</text></g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"205\" y=\"342\">Perfect cache</text><text x=\"375\" y=\"342\">L1 only</text><text x=\"545\" y=\"342\">L1 + L2</text></g>\n          <text x=\"365\" y=\"368\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">Values computed in the worked example (DRAM = 100 cycles)</text>\n        </svg>\n        <figcaption><b>Figure 6.4.1</b> CPI stack for the worked example. With L1 alone, memory stalls (3.5 cycles) are almost three times the useful work (1.2 cycles). The L2 cache shrinks both stall bars to less than a third, because each L1 miss now costs 30 cycles instead of 100.</figcaption>\n      </figure>",
 "5": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Address translation: virtual page number goes to the TLB; on a hit the frame number joins the offset to form the physical address; on a miss the page table is walked; an invalid entry causes a page fault handled by the OS from disk\">\n          <defs><marker id=\"m651\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <text x=\"200\" y=\"20\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Virtual address from the CPU</text>\n          <rect x=\"40\" y=\"30\" width=\"200\" height=\"40\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <rect x=\"240\" y=\"30\" width=\"120\" height=\"40\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"140\" y=\"55\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">VPN · 20 bits</text>\n          <text x=\"300\" y=\"55\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Offset · 12</text>\n          <rect x=\"40\" y=\"110\" width=\"200\" height=\"70\" rx=\"8\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"140\" y=\"138\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">TLB</text>\n          <text x=\"140\" y=\"160\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">recent VPN → PFN</text>\n          <text x=\"560\" y=\"120\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Physical address</text>\n          <rect x=\"440\" y=\"130\" width=\"150\" height=\"40\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <rect x=\"590\" y=\"130\" width=\"90\" height=\"40\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <text x=\"515\" y=\"155\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">PFN · 18 bits</text>\n          <text x=\"635\" y=\"155\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Offset</text>\n          <rect x=\"460\" y=\"215\" width=\"220\" height=\"45\" rx=\"8\" style=\"fill:var(--panel);stroke:var(--next);stroke-width:2\"/>\n          <text x=\"570\" y=\"243\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Cache, then main memory</text>\n          <rect x=\"40\" y=\"230\" width=\"200\" height=\"60\" rx=\"8\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"140\" y=\"256\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Page-table walk</text>\n          <text x=\"140\" y=\"276\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">(table in memory, PTBR)</text>\n          <rect x=\"40\" y=\"340\" width=\"270\" height=\"60\" rx=\"8\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <text x=\"175\" y=\"365\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Page fault → OS handler</text>\n          <text x=\"175\" y=\"385\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">fetch page, update PTE, restart</text>\n          <rect x=\"480\" y=\"340\" width=\"200\" height=\"60\" rx=\"8\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <text x=\"580\" y=\"375\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\">Disk or SSD (swap)</text>\n          <g style=\"stroke:var(--muted);stroke-width:2;fill:none\" marker-end=\"url(#m651)\">\n            <path d=\"M140,70 V108\"/>\n            <path d=\"M240,140 H438\"/>\n            <path d=\"M300,70 V88 H635 V128\"/>\n            <path d=\"M515,170 V213\"/>\n            <path d=\"M140,180 V228\"/>\n            <path d=\"M240,260 H290 V165 H243\"/>\n            <path d=\"M140,290 V338\"/>\n            <path d=\"M310,370 H478\"/>\n            <path d=\"M580,340 V262\"/>\n          </g>\n          <g font-size=\"13\" fill=\"currentColor\">\n            <text x=\"330\" y=\"132\">hit</text>\n            <text x=\"470\" y=\"80\">offset copied unchanged</text>\n            <text x=\"150\" y=\"210\">miss</text>\n            <text x=\"300\" y=\"215\">valid: copy PTE</text>\n            <text x=\"300\" y=\"231\">to TLB, retry</text>\n            <text x=\"150\" y=\"320\">not valid</text>\n            <text x=\"350\" y=\"362\">read page</text>\n            <text x=\"572\" y=\"305\" text-anchor=\"end\">page into a free frame</text>\n          </g>\n        </svg>\n        <figcaption><b>Figure 6.5.1</b> Translating a virtual address. The common case is the top path: the TLB hits and the frame number joins the untouched offset. A TLB miss costs a page-table walk in memory; only an invalid PTE causes a page fault, which the operating system services from disk.</figcaption>\n      </figure>",
 "6": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 410\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Hard disk: top view with tracks, a sector, spindle and head on an arm; side view with three platters, six heads on arms and a cylinder\">\n          <text x=\"180\" y=\"28\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">platter turns at 7,200 rpm</text>\n          <circle cx=\"180\" cy=\"190\" r=\"150\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/>\n          <g style=\"fill:none;stroke:var(--line2);stroke-width:1.5\"><circle cx=\"180\" cy=\"190\" r=\"120\"/><circle cx=\"180\" cy=\"190\" r=\"95\"/><circle cx=\"180\" cy=\"190\" r=\"70\"/></g>\n          <path d=\"M283.9,130 A120,120 0 0 1 299.5,179.5 L274.6,181.7 A95,95 0 0 0 262.3,142.5 Z\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <circle cx=\"180\" cy=\"190\" r=\"32\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"180\" y=\"195\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">spindle</text>\n          <line x1=\"350\" y1=\"330\" x2=\"260\" y2=\"268\" style=\"stroke:var(--muted);stroke-width:5\"/>\n          <rect x=\"250\" y=\"260\" width=\"16\" height=\"16\" style=\"fill:var(--next);stroke:var(--next)\"/>\n          <circle cx=\"350\" cy=\"330\" r=\"9\" style=\"fill:var(--panel);stroke:var(--muted);stroke-width:2\"/>\n          <text x=\"350\" y=\"362\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">arm with head</text>\n          <text x=\"40\" y=\"60\" font-size=\"13\" fill=\"currentColor\">track</text>\n          <line x1=\"66\" y1=\"66\" x2=\"128\" y2=\"138\" style=\"stroke:var(--muted);stroke-width:1.5\"/>\n          <text x=\"306\" y=\"100\" font-size=\"13\" fill=\"currentColor\">sector</text>\n          <line x1=\"318\" y1=\"105\" x2=\"290\" y2=\"140\" style=\"stroke:var(--muted);stroke-width:1.5\"/>\n          <text x=\"180\" y=\"398\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Top view of one surface</text>\n          <text x=\"545\" y=\"40\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">cylinder = same track, every surface</text>\n          <line x1=\"540\" y1=\"60\" x2=\"540\" y2=\"300\" style=\"stroke:var(--muted);stroke-width:3\"/>\n          <g style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"><rect x=\"440\" y=\"109\" width=\"200\" height=\"8\" rx=\"3\"/><rect x=\"440\" y=\"189\" width=\"200\" height=\"8\" rx=\"3\"/><rect x=\"440\" y=\"269\" width=\"200\" height=\"8\" rx=\"3\"/></g>\n          <rect x=\"414\" y=\"88\" width=\"10\" height=\"212\" style=\"fill:var(--panel);stroke:var(--muted);stroke-width:2\"/>\n          <g style=\"stroke:var(--muted);stroke-width:2\"><line x1=\"424\" y1=\"100\" x2=\"500\" y2=\"100\"/><line x1=\"424\" y1=\"126\" x2=\"500\" y2=\"126\"/><line x1=\"424\" y1=\"180\" x2=\"500\" y2=\"180\"/><line x1=\"424\" y1=\"206\" x2=\"500\" y2=\"206\"/><line x1=\"424\" y1=\"260\" x2=\"500\" y2=\"260\"/><line x1=\"424\" y1=\"286\" x2=\"500\" y2=\"286\"/></g>\n          <g style=\"fill:var(--next);stroke:var(--next)\"><rect x=\"498\" y=\"95\" width=\"10\" height=\"10\"/><rect x=\"498\" y=\"121\" width=\"10\" height=\"10\"/><rect x=\"498\" y=\"175\" width=\"10\" height=\"10\"/><rect x=\"498\" y=\"201\" width=\"10\" height=\"10\"/><rect x=\"498\" y=\"255\" width=\"10\" height=\"10\"/><rect x=\"498\" y=\"281\" width=\"10\" height=\"10\"/></g>\n          <line x1=\"503\" y1=\"84\" x2=\"503\" y2=\"304\" style=\"stroke:var(--live);stroke-width:1.5\" stroke-dasharray=\"4 4\"/>\n          <text x=\"650\" y=\"118\" font-size=\"13\" fill=\"currentColor\">platter</text>\n          <text x=\"470\" y=\"348\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">6 heads, one per surface</text>\n          <text x=\"540\" y=\"320\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">spindle</text>\n          <text x=\"545\" y=\"398\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Side view: 3 platters</text>\n        </svg>\n        <figcaption><b>Figure 6.6.1</b> Geometry of a hard disk. Left: a surface with three of its many thousand tracks, one sector shaded, and the head on its arm. Right: three platters give six surfaces and six heads that move together; the dashed line marks one cylinder. Seek moves the arms; rotation brings the sector under the head.</figcaption>\n      </figure>",
 "7": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 345\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Timing diagram of an asynchronous full handshake input transfer with address and command, Master-ready, Slave-ready and data signals and times t0 to t5\">\n          <g style=\"stroke:var(--line2);stroke-width:1\" stroke-dasharray=\"3 4\"><line x1=\"230\" y1=\"40\" x2=\"230\" y2=\"305\"/><line x1=\"300\" y1=\"40\" x2=\"300\" y2=\"305\"/><line x1=\"380\" y1=\"40\" x2=\"380\" y2=\"305\"/><line x1=\"470\" y1=\"40\" x2=\"470\" y2=\"305\"/><line x1=\"550\" y1=\"40\" x2=\"550\" y2=\"305\"/><line x1=\"630\" y1=\"40\" x2=\"630\" y2=\"305\"/></g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"230\" y=\"326\">t0</text><text x=\"300\" y=\"326\">t1</text><text x=\"380\" y=\"326\">t2</text><text x=\"470\" y=\"326\">t3</text><text x=\"550\" y=\"326\">t4</text><text x=\"630\" y=\"326\">t5</text></g>\n          <g font-size=\"13\" fill=\"currentColor\"><text x=\"16\" y=\"66\">Address and</text><text x=\"16\" y=\"82\">command</text><text x=\"16\" y=\"145\">Master-ready</text><text x=\"16\" y=\"215\">Slave-ready</text><text x=\"16\" y=\"276\">Data</text><text x=\"16\" y=\"292\">(slave → master)</text></g>\n          <g style=\"stroke:var(--muted);stroke-width:2;fill:none\"><path d=\"M190,70 H230\"/><path d=\"M550,70 H690\"/><path d=\"M190,280 H380\"/><path d=\"M630,280 H690\"/></g>\n          <path d=\"M230,70 L238,55 H542 L550,70 L542,85 H238 Z\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <path d=\"M380,280 L388,265 H622 L630,280 L622,295 H388 Z\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <text x=\"390\" y=\"75\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">address of slave, Read</text>\n          <text x=\"505\" y=\"285\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">data valid</text>\n          <path d=\"M190,155 H300 V125 H470 V155 H690\" style=\"stroke:var(--live);stroke-width:2.5;fill:none\"/>\n          <path d=\"M190,225 H380 V195 H630 V225 H690\" style=\"stroke:var(--live);stroke-width:2.5;fill:none\"/>\n        </svg>\n        <figcaption><b>Figure 6.7.1</b> Full handshake for reading from a slave on an asynchronous bus. t0: the master puts the address and Read command on the bus. t1: after a short delay for the addresses to settle, it raises Master-ready. t2: the addressed slave puts the data on the bus and raises Slave-ready. t3: the master latches the data and drops Master-ready. t4: the master removes the address; the slave, seeing Master-ready drop, removes the data and at t5 drops Slave-ready. Each edge answers the other side's edge, so no clock is needed.</figcaption>\n      </figure>",
 "8": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 400\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Control passes from instruction i of the main program to the interrupt service routine and back to instruction i plus 1, with the return address and PSW saved on the stack\">\n          <defs><marker id=\"m681\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <g font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\"><text x=\"170\" y=\"40\">Main program</text><text x=\"560\" y=\"40\">Interrupt service routine</text></g>\n          <g style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"><rect x=\"90\" y=\"60\" width=\"160\" height=\"36\" rx=\"5\"/><rect x=\"90\" y=\"200\" width=\"160\" height=\"36\" rx=\"5\"/><rect x=\"90\" y=\"250\" width=\"160\" height=\"36\" rx=\"5\"/></g>\n          <rect x=\"90\" y=\"110\" width=\"160\" height=\"36\" rx=\"5\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <g font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"170\" y=\"83\">instruction i − 1</text><text x=\"170\" y=\"133\">instruction i</text><text x=\"170\" y=\"223\">instruction i + 1</text><text x=\"170\" y=\"273\">instruction i + 2</text></g>\n          <text x=\"170\" y=\"178\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">(paused)</text>\n          <text x=\"16\" y=\"133\" font-size=\"13\" fill=\"currentColor\" font-weight=\"600\">INTR</text>\n          <g style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"><rect x=\"430\" y=\"60\" width=\"260\" height=\"36\" rx=\"5\"/><rect x=\"430\" y=\"110\" width=\"260\" height=\"36\" rx=\"5\"/><rect x=\"430\" y=\"160\" width=\"260\" height=\"36\" rx=\"5\"/><rect x=\"430\" y=\"210\" width=\"260\" height=\"36\" rx=\"5\"/><rect x=\"430\" y=\"260\" width=\"260\" height=\"36\" rx=\"5\"/></g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"560\" y=\"83\">save registers it uses</text><text x=\"560\" y=\"133\">read DATA (clears the request)</text><text x=\"560\" y=\"183\">put the character in a buffer</text><text x=\"560\" y=\"233\">restore registers</text><text x=\"560\" y=\"283\">return from interrupt (IRET)</text></g>\n          <g style=\"stroke:var(--muted);stroke-width:2;fill:none\" marker-end=\"url(#m681)\">\n            <path d=\"M54,128 H88\"/>\n            <path d=\"M250,128 H310 V78 H428\"/>\n            <path d=\"M430,278 H310 V218 H253\"/>\n            <path d=\"M560,96 V108\"/><path d=\"M560,146 V158\"/><path d=\"M560,196 V208\"/><path d=\"M560,246 V258\"/>\n          </g>\n          <g font-size=\"13\" fill=\"currentColor\"><text x=\"318\" y=\"104\">save PC, PSW;</text><text x=\"318\" y=\"120\">jump via vector</text><text x=\"318\" y=\"246\">restore PSW, PC;</text><text x=\"318\" y=\"262\">resume at i + 1</text></g>\n          <text x=\"170\" y=\"316\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Stack while the ISR runs</text>\n          <rect x=\"90\" y=\"326\" width=\"160\" height=\"28\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"/>\n          <rect x=\"90\" y=\"354\" width=\"160\" height=\"28\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:1.5\"/>\n          <text x=\"170\" y=\"345\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">top: address of i + 1</text>\n          <text x=\"170\" y=\"373\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">PSW (flags)</text>\n        </svg>\n        <figcaption><b>Figure 6.8.1</b> Handling a keyboard interrupt. The request arrives during instruction i; the processor finishes i, pushes the PSW and the return address (i + 1), and jumps to the ISR. IRET pops both, so the main program resumes at i + 1 without knowing it was interrupted.</figcaption>\n      </figure>",
 "9": "<figure class=\"fig\">\n        <svg viewBox=\"0 0 720 400\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"DMA block diagram: processor, main memory, DMA controller with address, count and control registers, and disk controller on the system bus, with bus request and grant, DREQ and DACK and interrupt lines\">\n          <defs><marker id=\"m691\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--muted)\"/></marker></defs>\n          <rect x=\"40\" y=\"50\" width=\"160\" height=\"80\" rx=\"8\" style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"120\" y=\"86\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Processor</text>\n          <text x=\"120\" y=\"106\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">(with cache)</text>\n          <rect x=\"500\" y=\"50\" width=\"180\" height=\"80\" rx=\"8\" style=\"fill:var(--next-soft);stroke:var(--next);stroke-width:2\"/>\n          <text x=\"590\" y=\"86\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Main memory</text>\n          <text x=\"590\" y=\"106\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">buffer for the block</text>\n          <line x1=\"24\" y1=\"200\" x2=\"696\" y2=\"200\" style=\"stroke:var(--ink);stroke-width:5\"/>\n          <text x=\"440\" y=\"190\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">System bus (address, data, control)</text>\n          <g style=\"stroke:var(--ink);stroke-width:2.5\"><line x1=\"150\" y1=\"130\" x2=\"150\" y2=\"200\"/><line x1=\"590\" y1=\"130\" x2=\"590\" y2=\"200\"/><line x1=\"380\" y1=\"200\" x2=\"380\" y2=\"250\"/><line x1=\"610\" y1=\"200\" x2=\"610\" y2=\"260\"/></g>\n          <rect x=\"250\" y=\"250\" width=\"220\" height=\"130\" rx=\"8\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/>\n          <text x=\"360\" y=\"272\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">DMA controller</text>\n          <g style=\"fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5\"><rect x=\"265\" y=\"282\" width=\"190\" height=\"26\"/><rect x=\"265\" y=\"312\" width=\"190\" height=\"26\"/><rect x=\"265\" y=\"342\" width=\"190\" height=\"26\"/></g>\n          <g font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\"><text x=\"360\" y=\"300\">memory address register</text><text x=\"360\" y=\"330\">word count register</text><text x=\"360\" y=\"360\">control / status register</text></g>\n          <rect x=\"540\" y=\"260\" width=\"140\" height=\"80\" rx=\"8\" style=\"fill:var(--live-soft);stroke:var(--live);stroke-width:2\"/>\n          <text x=\"610\" y=\"296\" font-size=\"14\" text-anchor=\"middle\" fill=\"currentColor\" font-weight=\"600\">Disk</text>\n          <text x=\"610\" y=\"316\" font-size=\"13\" text-anchor=\"middle\" fill=\"currentColor\">controller</text>\n          <g style=\"stroke:var(--muted);stroke-width:2;fill:none\" marker-end=\"url(#m691)\">\n            <path d=\"M250,346 H70 V132\"/>\n            <path d=\"M95,130 V300 H248\"/>\n            <path d=\"M538,285 H472\"/>\n            <path d=\"M472,318 H538\"/>\n            <path d=\"M300,250 V112 H203\"/>\n          </g>\n          <g font-size=\"13\" fill=\"currentColor\"><text x=\"105\" y=\"294\">bus grant (BG)</text><text x=\"105\" y=\"340\">bus request (BR)</text><text x=\"478\" y=\"279\">DREQ</text><text x=\"478\" y=\"312\">DACK</text><text x=\"308\" y=\"150\">interrupt when</text><text x=\"308\" y=\"166\">count = 0</text></g>\n        </svg>\n        <figcaption><b>Figure 6.9.1</b> A DMA transfer from disk to memory. After the processor loads the three registers, the DMA controller requests the bus (BR), receives it (BG), and moves each word from the disk controller straight to memory over the system bus. The processor hears from it again only through the interrupt when the count reaches zero.</figcaption>\n      </figure>"
}