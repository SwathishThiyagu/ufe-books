{
 "1": "<figure class=\"fig\"><svg viewBox=\"0 0 720 160\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"The interaction advances one step. Reward belongs to the transition just taken; the next state supplies the next decision context.\"><rect x=\"16\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"124\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Agent</text><text x=\"124\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">chooses Aₜ</text><text x=\"242\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"252\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"360\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Environment</text><text x=\"360\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">returns Rₜ₊₁, Sₜ₊₁</text><text x=\"478\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"488\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"596\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Next decision</text><text x=\"596\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">repeat until terminal</text></svg><figcaption><b>Figure 6.1.1</b> The interaction advances one step. Reward belongs to the transition just taken; the next state supplies the next decision context.</figcaption></figure>",
 "2": "<figure class=\"fig\"><svg viewBox=\"0 0 720 160\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"One sampled transition produces a target, then changes one table entry. For terminal transitions the target is just r.\"><rect x=\"16\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"124\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Sample</text><text x=\"124\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">s, a, r, s′</text><text x=\"242\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"252\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"360\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Target</text><text x=\"360\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">r + γ max Q(s′, b)</text><text x=\"478\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"488\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"596\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Update</text><text x=\"596\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">Q ← Q + α(target − Q)</text></svg><figcaption><b>Figure 6.2.1</b> One sampled transition produces a target, then changes one table entry. For terminal transitions the target is just r.</figcaption></figure>",
 "3": "<figure class=\"fig\"><svg viewBox=\"0 0 720 160\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Sequential covering removes handled positives from the remaining search task. The final rules can overlap on P2.\"><rect x=\"16\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"124\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Rule 1: A = yes</text><text x=\"124\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">covers P1, P2</text><text x=\"242\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"252\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"360\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Remove P1, P2</text><text x=\"360\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">P3 still uncovered</text><text x=\"478\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"488\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"596\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Rule 2: B = yes</text><text x=\"596\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">covers P2, P3</text></svg><figcaption><b>Figure 6.3.1</b> Sequential covering removes handled positives from the remaining search task. The final rules can overlap on P2.</figcaption></figure>",
 "4": "<figure class=\"fig\"><svg viewBox=\"0 0 720 160\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"The shared intermediate variable joins two parent facts. Different unrelated witnesses cannot satisfy the same Y.\"><rect x=\"16\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"124\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">parent(asha, bala)</text><text x=\"124\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">X = asha, Y = bala</text><text x=\"242\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"252\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"360\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">parent(bala, chitra)</text><text x=\"360\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">same Y; Z = chitra</text><text x=\"478\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"488\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"596\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">grandparent(asha,</text><text x=\"596\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">chitra) follows</text></svg><figcaption><b>Figure 6.4.1</b> The shared intermediate variable joins two parent facts. Different unrelated witnesses cannot satisfy the same Y.</figcaption></figure>",
 "5": "<figure class=\"fig\"><svg viewBox=\"0 0 720 160\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"EBL converts the requirements of a proof into a reusable sufficient condition. Unused example attributes do not enter that condition.\"><rect x=\"16\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"124\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Example + theory</text><text x=\"124\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">prove the target</text><text x=\"242\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"252\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"360\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Relevant premises</text><text x=\"360\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">generalize the proof</text><text x=\"478\" y=\"77\" text-anchor=\"middle\" font-size=\"19\" fill=\"currentColor\">→</text><rect x=\"488\" y=\"24\" width=\"216\" height=\"88\" rx=\"10\" style=\"fill:var(--panel);stroke:var(--accent);stroke-width:2\"/><text x=\"596\" y=\"58\" text-anchor=\"middle\" font-size=\"18\" fill=\"currentColor\">Operational rule</text><text x=\"596\" y=\"87\" text-anchor=\"middle\" font-size=\"16\" fill=\"currentColor\">test measured features</text></svg><figcaption><b>Figure 6.5.1</b> EBL converts the requirements of a proof into a reusable sufficient condition. Unused example attributes do not enter that condition.</figcaption></figure>"
}